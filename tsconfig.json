{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "tests/**/*.ts",
    "Pages/**/*.ts",
    "fixtures/**/*.ts",
    "specs/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
